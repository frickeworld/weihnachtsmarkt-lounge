# Kopiere diese Datei nach .env.local und trage die Werte ein. .env.local wird nie committet.
# Nur öffentliche Werte! Secret Keys (Stripe, Brevo, Service Role) gehören NIE hierher.
VITE_SUPABASE_URL=https://[PROJEKT-REF].supabase.co
VITE_SUPABASE_ANON_KEY=[ANON-KEY]
VITE_PUBLIC_SITE_URL=http://localhost:5173
# true = Seite wird mit noindex ausgeliefert (Vorschau, Entwicklung)
VITE_NOINDEX=true
